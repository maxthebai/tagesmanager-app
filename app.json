{
  "expo": {
    "name": "Tagesmanager",
    "slug": "tagesmanager-app",
    "version": "0.4.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#131314",
    "android": {
      "package": "de.maxthebai.tagesmanager",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#131314",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Der Tagesmanager liest und ändert deine Kalendertermine, um deinen Tag zu planen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Der Tagesmanager liest ein Foto nur, wenn du es auswählst.",
          "cameraPermission": "Der Tagesmanager nutzt die Kamera nur, wenn du ein Foto für den Agenten aufnimmst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#a8c7fa"
        }
      ]
    ],
    "userInterfaceStyle": "automatic"
  }
}
